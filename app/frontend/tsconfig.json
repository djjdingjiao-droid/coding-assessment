{
  "compilerOptions": {
    "target": "ES2020", "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"], "allowJs": false,
    "skipLibCheck": true, "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "strict": true, "module": "ESNext", "moduleResolution": "Bundler",
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "jsx": "react-jsx", "types": ["vite/client", "vitest/globals"]
  }, "include": ["src.tsx", "src.test.tsx", "vite.config.ts"]
}
